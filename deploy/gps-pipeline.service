[Unit]
Description=globalpatientsafety.com ClinicalTrials.gov pipeline
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/opt/gps-pipeline
# 3842 is the faers MCP server. 3843 and 3844 are the FAERS R APIs.
ExecStart=/usr/bin/python3 /opt/gps-pipeline/gps_pipeline.py --bind 127.0.0.1 --port 3845
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
