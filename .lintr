linters:
  linters_with_defaults(
    defaults = box.linters::rhino_default_linters,
    # Relaxed from 100 to accommodate long content strings (tool taglines,
    # article metadata, inline HTML/method descriptions) that read worse when
    # hard-wrapped.
    line_length_linter = line_length_linter(500),
    # Disabled: conflicts with box_func_import_count (max 8) for Shiny UI
    # modules that legitimately use 15-20 shiny functions — the two cannot both
    # be satisfied, so we allow attach-all `shiny[...]` rather than inflate the
    # count limit or hand-maintain 20-item import lists.
    box_universal_import_linter = NULL,
    # Allow intentional UPPERCASE data constants (ARTICLES, TOOLS) and
    # dot-prefixed private registries (.ARTICLE_MODULES) alongside snake_case.
    object_name_linter = object_name_linter(styles = c("snake_case", "SNAKE_CASE", "symbols")),
    # Disabled: false positives. It flags #'@export'ed module functions (e.g.
    # `server` in app/main) as "not exported" because its static box-path
    # resolution fails; the app runs and the Cypress e2e suite passes.
    box_mod_fun_exists_linter = NULL,
    # Disabled: false positives / unresolvable. Flags exported package
    # functions (dplyr arrange/desc/filter/select) as "not exported", and can't
    # resolve `safetysignal` at all (it's a local package, not in renv.lock) in
    # the legacy signal_engine.R / signal_table.R modules (unused by the portal).
    box_pkg_fun_exists_linter = NULL,
    # Disabled: false positives. It flags objects that ARE used — e.g.
    # VACCINE_COLOURS (used in scale_colour_manual), and `thromb`/`cardiac`
    # (passed to ggplot2::ggplot) in article_covid_vaccine.R — as unused,
    # because it doesn't see usage inside `pkg::fun(...)` qualified calls.
    unused_declared_object_linter = NULL
  )
