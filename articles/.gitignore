/.quarto/
**/*.quarto_ipynb
# Quarto per-document resource dirs (libs/) — the rendered HTML is embed-resources,
# the self-contained copy lives in app/static/<id>.html
*_files/
# Rendered HTML stays in app/static/, not here
*.html
# Review intermediates (regenerable); keep the model reviews themselves
reviews/.asksage-archive.txt
reviews/*_rendered.md
